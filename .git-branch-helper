#!/usr/bin/env bash

# Require a clean index
git diff-index --quiet HEAD --
if [[ $? != 0 ]]; then
  >&2 echo There are uncommitted changes present
  exit 1
fi

# Do this after the above so a useful error can be displayed
set -e

DEFAULT_BRANCH=`git symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo origin/master`
TARGET_BRANCH=${DEFAULT_BRANCH#origin/}

while [[ $# -gt 0 ]]; do
  case $1 in
    -p|--pull) PULL=true ;;
    -i|--interactive) REBASE_ARGS=$1 ;;
    mark_as_merged) COMMAND=$1; PULL=true ;;
    rebase) COMMAND=$1 ;;
    *) TARGET_BRANCH=$1 ;;
  esac
  shift
done

CURRENT_BRANCH=`git rev-parse --abbrev-ref HEAD`
if [[ $CURRENT_BRANCH == $TARGET_BRANCH ]]; then
  >&2 echo Already on $TARGET_BRANCH branch
  exit 1
fi

if [[ $COMMAND == 'rebase' ]]; then
  # Fetch rather than pull, and rebase onto the remote branch - git won't check out a branch that another worktree
  # already has checked out.
  if [[ $PULL ]]; then
    git fetch origin $TARGET_BRANCH
  fi

  if git show-ref --verify --quiet refs/remotes/origin/$TARGET_BRANCH; then
    git rebase $REBASE_ARGS origin/$TARGET_BRANCH
  else
    git rebase $REBASE_ARGS $TARGET_BRANCH
  fi
elif [[ $COMMAND == 'mark_as_merged' ]]; then
  git checkout $TARGET_BRANCH
  git pull
  git branch -d $CURRENT_BRANCH
  git remote prune origin
fi
